.red {
    border-left-color: rgb(255, 176, 154);
    border-right-color: rgb(255, 176, 154);
    border-top-color: rgb(255, 176, 154);
    border-bottom-color: rgb(255, 176, 154);
    background-color: rgb(241, 61, 11);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.red:active {
    background-color: rgb(169, 43, 9);
}

Button {
    color: rgb(255, 255, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-right: 12px;
    padding-left: 12px;
}
